# Copy to .env for local work. On Posit Connect set the same names under Content Settings -> Vars.
# The first four are the SAME names the Country Benchmarking Dashboard uses, so one service principal can serve both apps.

DATABRICKS_SERVER_HOSTNAME= "YOUR_SERVER_HOSTNAME_HERE"
DATABRICKS_HTTP_PATH= "YOUR_HTTP_PATH_HERE"
DATABRICKS_CLIENT_ID= "YOUR_CLIENT_ID_HERE"
DATABRICKS_CLIENT_SECRET= "YOUR_CLIENT_SECRET_HERE"

# Uploads
# CBT_MAX_UPLOAD_MB=60
# CBT_MAX_ROWS=500000
# CBT_WORK_DIR=/tmp/cbt_work

QUERY_CACHE_TTL_SECONDS= 60
QUERY_CACHE_MAX_ENTRIES= 256
