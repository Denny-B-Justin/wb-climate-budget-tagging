# Copy to .env for local work. On Posit Connect / Databricks Apps set the same names as environment variables.
# The first four are the SAME names the Country Benchmarking Dashboard uses, so one service principal can serve both apps.

DATABRICKS_SERVER_HOSTNAME= "YOUR_SERVER_HOSTNAME_HERE"
DATABRICKS_HTTP_PATH= "YOUR_HTTP_PATH_HERE"
DATABRICKS_CLIENT_ID= "YOUR_CLIENT_ID_HERE"
DATABRICKS_CLIENT_SECRET= "YOUR_CLIENT_SECRET_HERE"
# DATABRICKS_TOKEN=                      # personal access token - local development only

# Where the two global tables live (the app creates them if they are missing and the principal may CREATE TABLE)
CBT_CATALOG= prd_mega
CBT_SCHEMA= sgpbpi163

# CBT_AUTO_CREATE_TABLES=true

# Writing to Unity Catalog: "json" (default, fast, 1 parameter per statement) or "values" (portable fallback)
# CBT_INSERT_MODE=json
# CBT_INSERT_CHUNK_ROWS=1500

# Who may soft-delete / restore versions (comma-separated e-mails). Empty = every signed-in user.
# CBT_ADMIN_USERS=ana@example.org,ben@example.org

# Uploads
# CBT_MAX_UPLOAD_MB=60
# CBT_MAX_ROWS=500000
# CBT_WORK_DIR=/tmp/cbt_work

QUERY_CACHE_TTL_SECONDS= 60
QUERY_CACHE_MAX_ENTRIES= 256
